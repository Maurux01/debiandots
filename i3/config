# ==========================================
# I3WM CONFIGURATION (Theme: Gruvbox Dark)
# ==========================================

set $mod Mod4
set $term kitty
set $filemanager thunar
set $launcher rofi -show drun -theme-str 'window {width: 50%;} listview {columns: 1;}'

# --- AUTOSTART (guarded: no error if a package is missing) ---
exec --no-startup-id sh -c "command -v xrdb >/dev/null && xrdb -merge ~/.Xresources"
exec --no-startup-id sh -c "command -v xsetroot >/dev/null && xsetroot -cursor_name left_ptr"
exec --no-startup-id sh -c "command -v lxpolkit >/dev/null && lxpolkit"
exec --no-startup-id sh -c "command -v nm-applet >/dev/null && nm-applet"
exec --no-startup-id sh -c "command -v xfce4-power-manager >/dev/null && xfce4-power-manager"
exec --no-startup-id sh -c "command -v dunst >/dev/null && dunst"
exec --no-startup-id sh -c "command -v picom >/dev/null && picom -b"
exec --no-startup-id sh -c "command -v redshift >/dev/null && redshift -c ~/.config/redshift/redshift.conf &"
exec --no-startup-id sh -c "command -v xautolock >/dev/null && xautolock -time 10 -locker ~/.config/i3/lock.sh &"
exec_always --no-startup-id ~/.config/polybar/launch.sh &

# Default static wallpaper (change the path to your image)
exec --no-startup-id ~/.config/i3/static-wp.sh ~/.config/i3/wallpaper.jpg

# --- APPEARANCE AND BORDERS ---
new_window pixel 2
new_float normal
hide_edge_borders both

# Gaps (minimal moderno, requiere i3 >= 4.22 en Debian 12+)
gaps inner 10
gaps outer 5
smart_gaps on
smart_borders on

# Colors (Gruvbox Dark Palette)
# bg: #282828, bg-alt: #3c3836, fg: #ebdbb2, accent: #fabd2f, urgent: #fb4934, muted: #a89984

# class                 border  backgr. text    indicator child_border
client.focused          #fabd2f #282828 #ebdbb2 #fabd2f   #fabd2f
client.focused_inactive #3c3836 #3c3836 #a89984 #3c3836   #3c3836
client.unfocused        #282828 #282828 #a89984 #282828   #282828
client.urgent           #fb4934 #fb4934 #282828 #fb4934   #fb4934

# --- KEYBINDS ---

# Terminal and App Launcher
bindsym $mod+Return exec $term
bindsym $mod+d exec $launcher

# File Manager
bindsym $mod+e exec $filemanager

# Close window
bindsym $mod+q kill

# Navigation and Movement (Vim-style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Window splits
bindsym $mod+v split v
bindsym $mod+Shift+space floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+e layout toggle split

# --- HARDWARE CONTROL ---

# Brightness with OSD (brightnessctl + dunst)
bindsym XF86MonBrightnessUp exec ~/.config/i3/brightness.sh up
bindsym XF86MonBrightnessDown exec ~/.config/i3/brightness.sh down

# Volume with OSD (pactl + dunst, pavucontrol for GUI)
bindsym XF86AudioRaiseVolume exec ~/.config/i3/volume.sh up
bindsym XF86AudioLowerVolume exec ~/.config/i3/volume.sh down
bindsym XF86AudioMute exec ~/.config/i3/volume.sh mute
# Night light toggle (redshift USR1)
bindsym $mod+Shift+n exec sh -c "command -v pkill >/dev/null && pkill -USR1 redshift"
bindsym $mod+Shift+v exec pavucontrol

# --- WALLPAPER MANAGEMENT ---

# Static wallpaper (Mod + Shift + w) - $mod+w se reserva para layout tabbed
bindsym $mod+Shift+w exec ~/.config/i3/static-wp.sh

# Live wallpaper (Mod + Ctrl + Shift + w) - Requires a video file
bindsym $mod+Ctrl+Shift+w exec ~/.config/i3/live-wp.sh ~/.config/i3/live-wallpaper.mp4

# --- SYSTEM ---
# Lock ($mod+l esta ocupado por focus right, se usa Ctrl+l)
bindsym $mod+Ctrl+l exec ~/.config/i3/lock.sh
bindsym XF86ScreenSaver exec ~/.config/i3/lock.sh
exec --no-startup-id sh -c "command -v xss-lock >/dev/null && xss-lock --transfer-sleep-lock -- ~/.config/i3/lock.sh" &
# Powermenu rofi gruvbox (reemplaza i3-nagbar feo)
bindsym $mod+Shift+x exec ~/.config/i3/powermenu.sh
# Screenshots (maim + xclip)
bindsym Print exec ~/.config/i3/screenshot.sh select
bindsym $mod+Print exec ~/.config/i3/screenshot.sh full
bindsym $mod+Shift+s exec ~/.config/i3/screenshot.sh select
bindsym $mod+Shift+r reload
bindsym $mod+Shift+c restart