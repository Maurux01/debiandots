[global]
# Catppuccin Mocha
font = JetBrainsMono Nerd Font 10
format = "<b>%s</b>\n%b"
alignment = center
vertical_alignment = center
width = 300
height = 100
offset = 10x20
origin = top-right
frame_width = 2
frame_color = "#cba6f7"
separator_color = frame

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_critical]
background = "#313244"
foreground = "#f38ba8"
frame_color = "#f38ba8"